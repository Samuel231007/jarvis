# ============================================================
# Archivo de ejemplo — copia esto como .env y rellena los valores
# NUNCA subas el .env real a GitHub
# ============================================================

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=

# Tu ID de usuario de Telegram (obtenido de @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# API Key de Gemini (obtenida en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# URL pública de tu servicio en Render (se completa después del despliegue)
# Ejemplo: https://jarvis-samuel.onrender.com
WEBHOOK_URL=

# Zona horaria del asistente
TIMEZONE=America/Bogota
